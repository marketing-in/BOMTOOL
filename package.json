{
  "name": "ems-sourcing-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run -s db:ensure && next dev --turbopack",
    "dev:webpack": "npm run -s db:ensure && next dev",
    "start": "tsx scripts/serve.ts",
    "serve": "tsx scripts/serve.ts",
    "online": "npm run -s db:ensure && tsx scripts/online.ts",
    "build": "next build",
    "start:next": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:local": "tsx scripts/db-local.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:setup": "prisma migrate deploy && prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate",
    "db:local:stop": "tsx scripts/db-local.ts stop",
    "db:e2e:setup": "tsx scripts/e2e-db.ts",
    "test:e2e": "npm run db:e2e:setup && playwright test",
    "sourcing": "tsx scripts/sourcing.ts",
    "worker": "tsx scripts/worker.ts",
    "knowledge:sync": "tsx scripts/knowledge-sync.ts",
    "vendors:sync": "tsx scripts/vendors-sync.ts",
    "analyse": "tsx --conditions=react-server scripts/analyse.ts",
    "test:site": "npm run db:e2e:setup && playwright test zzz-site-ui",
    "test:ui:capture": "tsx scripts/ui-review.ts",
    "db:ensure": "tsx --env-file-if-exists=.env scripts/db-ensure.ts",
    "plant:sync": "tsx --env-file-if-exists=.env scripts/plant-sync.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@prisma/client": "^6.19.3",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "fflate": "0.8.3",
    "gerber-to-svg": "^4.2.8",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.61.0",
    "next": "15.5.28",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "pcb-stackup": "^4.2.8",
    "prisma": "^6.19.3",
    "radix-ui": "^1.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "three": "^0.175.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.175.0",
    "embedded-postgres": "^17.9.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "ioredis-mock": "^8.13.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
