# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env (keep the example)
!.env.example

# local embedded postgres
/.pgdata/

# test output
/test-results/
/playwright-report/
/.next-e2e/

# production build for `npm run serve`
/.next-prod/
/.next-prod-b/
/.next-prod.lock
/.next-prod.current
/.next-prod-build.log
/.next-check/

# local tools (cloudflared)
/.tools/

# UI review runtime output
/.next-ui/
/.impeccable/mocks/
/.impeccable/questions/
/.impeccable/review/
/.impeccable/config.local.json
.pgdata/
