# Copy to .env and fill in. Never commit .env.

# --- Database (docker compose or `npm run db:local`) ---
# Port 5433: this project's own local database (./.pgdata), clear of other copies of the app that use 5432.
DATABASE_URL="postgresql://ems:ems@localhost:5433/ems?schema=public"
# E2E tests (npm run db:e2e:setup / test:e2e) use their own database: DATABASE_URL with the name
# swapped for ems_e2e. Set this only to use another one; it must not be the development database.
E2E_DATABASE_URL=""

# --- Auth ---
NEXTAUTH_URL="http://localhost:3000"
# Generate with: npx auth secret  (or any 32+ char random string)
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Password given to all seeded demo users (admin@ems.local, purchasing@ems.local, ...)
SEED_USER_PASSWORD="ChangeMe!2026"

# --- Background jobs / search (used from Phase 1/2) ---
REDIS_URL="redis://localhost:6379"
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY="dev-master-key-change-me"

# --- Currency ---
DEFAULT_CURRENCY="INR"
# Live FX, refreshed every 12 h. Free, no key: https://open.er-api.com/v6/latest/INR
# Leave empty to use the built-in mock rates.
FX_API_URL=""
FX_API_KEY=""

# --- Background jobs ---
# inline = in-process scheduler (no Redis needed); bullmq = Redis queue + `npm run worker` (Docker Compose)
JOBS_MODE="inline"
# Refresh parts on BoMs/carts/RFQs every N hours; full catalogue nightly 02:00 IST. SCHEDULER=off disables.
REFRESH_HOT_HOURS="4"
SCHEDULER="on"

# --- Sourcing ---
# auto = simulated market only while no real distributor key is set (never mixes fake and live prices)
SOURCING_MOCK="auto"
# Currency asked from Nexar/DigiKey (Mouser prices in your account currency)
SOURCING_CURRENCY="INR"

# --- Distributor APIs (leave empty to stay on the mock market) ---
# Nexar / Octopart: nexar.com → create app with "Supply" scope. Free plan ≈ 1,000 parts/month.
NEXAR_CLIENT_ID=""
NEXAR_CLIENT_SECRET=""
NEXAR_DAILY_LIMIT="30"
# DigiKey: developer.digikey.com → Production app → Product Information v4
DIGIKEY_CLIENT_ID=""
DIGIKEY_CLIENT_SECRET=""
DIGIKEY_SITE="IN"
DIGIKEY_CURRENCY="INR"
DIGIKEY_DAILY_LIMIT="900"
# Mouser: mouser.in → My Account → APIs → Search API key
MOUSER_API_KEY=""
MOUSER_DAILY_LIMIT="900"
# element14 Product Search API (partner.element14.com → register → API key). One key serves Newark and element14:
# Newark (US, USD) and the element14 store below (India by default: in.element14.com, INR; sg.element14.com …).
ELEMENT14_API_KEY=""
ELEMENT14_STORE="in.element14.com"
ELEMENT14_CURRENCY=""
ELEMENT14_DAILY_LIMIT="900"
# Only if Newark gave you a key of its own (else the element14 key is used for Newark too):
NEWARK_API_KEY=""
NEWARK_STORE="www.newark.com"
NEWARK_DAILY_LIMIT="900"
# LCSC partner API (lcsc.com → API → apply; LCSC sends a key and a secret). Confirm the signing recipe in
# src/server/sourcing/adapters/lcsc.ts against LCSC's documents before relying on live data.
LCSC_API_KEY=""
LCSC_API_SECRET=""
LCSC_CURRENCY="USD"
LCSC_DAILY_LIMIT="900"
# Not yet wired (mock / price-list import for these):
ARROW_API_KEY=""
TME_TOKEN=""
TME_SECRET=""

# --- Ask Claude (the assistant in the top bar) ---
# Anthropic API key: console.anthropic.com → API keys. Server-side only; never sent to the browser.
# Leave empty to stay on the simulated assistant (answers assembled from the platform data, no AI).
ANTHROPIC_API_KEY=""
# Only for a key made at organisation level (Anthropic asks for a workspace on every request):
# Anthropic Console → Settings → Workspaces, the ID starts with wrkspc_. Leave empty for a key made inside a workspace.
ANTHROPIC_WORKSPACE_ID=""
# Model to answer with. Empty = claude-opus-5-5.
ANTHROPIC_MODEL=""
# auto = simulated only while no key is set; true = always simulated; false = never (a missing key is an error)
ASSISTANT_MOCK="auto"
# "Look up with Claude" on a machine searches the web for its datasheet. off = Claude answers from what it knows.
# (Web search must also be allowed for your organisation in the Anthropic console.)
ASSISTANT_WEB_SEARCH="on"

# Letterhead on customer quotes (Build & quote → print). Optional; leave empty to print without one.
COMPANY_NAME=""
COMPANY_ADDRESS=""
COMPANY_GSTIN=""
COMPANY_EMAIL=""
